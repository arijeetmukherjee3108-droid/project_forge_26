# ==============================================================================
# Voice-to-Legacy (.env.example) — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` and fill in your credentials.
# NEVER commit the actual `.env` file containing secret keys to version control.
# ==============================================================================

# Groq API (Used by llm_client.py for fast LLM Intent Fallback & Vision Extraction)
# Get a free key at: https://console.groq.com/keys (No credit card required)
GROQ_API_KEY="gsk_YourGroqApiKeyHere"
GROQ_MODEL="llama3-8b-8192"
GROQ_FALLBACK_MODEL="llama3-70b-8192"
GROQ_VISION_MODEL="llava-v1.5-7b-4096-preview"
GROQ_VISION_FALLBACK_MODEL="llava-v1.5-13b-4096-preview"

# Google Gemini API (For Gemini-specific workflows)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-1.5-flash"

# Google Cloud OAuth 2.0 (For Google Vault: Drive & Gmail Auto-Document Hunter)
GOOGLE_CLIENT_ID="434733256139-amj4gkvbl66f2pc7vok2762u0m5p0es0.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-YourClientSecretHere"

# Playwright Browser Agent Settings
# Set to 'true' for automated background tests, 'false' to watch the browser fill live
BROWSER_HEADLESS=false